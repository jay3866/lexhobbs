{
  // Cloudflare Workers Builds deploys this on every push to main: the static site from ./dist,
  // plus the Worker in worker/index.ts (quote API, admin panel at /admin, tag injection, counters).
  "name": "hobbsjunkremoval",
  "main": "worker/index.ts",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "hobbs-admin", "database_id": "9aed44bf-7103-41b0-a762-00ecb93553de" }
  ],
  "vars": {
    // Who can sign in to /admin (one-time code by email)
    "ADMIN_EMAILS": "hobbsjrhauling@gmail.com,reachjaybrown@gmail.com"
  },
  "keep_vars": true,
  "observability": { "enabled": true }
}
